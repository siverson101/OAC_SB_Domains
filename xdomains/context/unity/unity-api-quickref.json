{
  "schemaVersion": 1,
  "description": "Offline Unity API quick reference used by the unity-api-lookup Sense ability. Curated engine/middleware symbols with a summary and, where relevant, the replacement to prefer. Read-only, no Editor required.",
  "unityVersions": ["6.0", "6.3", "6.5", "LTS+"],
  "updated": "2026-09-20",
  "entries": [
    { "symbol": "GameObject", "kind": "class", "namespace": "UnityEngine", "summary": "Base object for scenes; holds components and a transform.", "docUrl": "https://docs.unity3d.com/ScriptReference/GameObject.html" },
    { "symbol": "MonoBehaviour", "kind": "class", "namespace": "UnityEngine", "summary": "Base class for scripts attached to GameObjects; receives Unity lifecycle messages.", "docUrl": "https://docs.unity3d.com/ScriptReference/MonoBehaviour.html" },
    { "symbol": "ScriptableObject", "kind": "class", "namespace": "UnityEngine", "summary": "Serializable data container not attached to a GameObject; use CreateAssetMenu to author assets.", "docUrl": "https://docs.unity3d.com/ScriptReference/ScriptableObject.html" },
    { "symbol": "Transform", "kind": "class", "namespace": "UnityEngine", "summary": "Position, rotation and scale of a GameObject; also the scene hierarchy node.", "docUrl": "https://docs.unity3d.com/ScriptReference/Transform.html" },
    { "symbol": "Vector3", "kind": "struct", "namespace": "UnityEngine", "summary": "Three-component float vector used for positions, directions and scales.", "docUrl": "https://docs.unity3d.com/ScriptReference/Vector3.html" },
    { "symbol": "Quaternion", "kind": "struct", "namespace": "UnityEngine", "summary": "Rotation representation; use Quaternion.Euler/LookRotation/Slerp.", "docUrl": "https://docs.unity3d.com/ScriptReference/Quaternion.html" },
    { "symbol": "Time", "kind": "class", "namespace": "UnityEngine", "summary": "Frame timing: deltaTime, timeScale, unscaledDeltaTime, fixedDeltaTime.", "docUrl": "https://docs.unity3d.com/ScriptReference/Time.html" },
    { "symbol": "Mathf", "kind": "class", "namespace": "UnityEngine", "summary": "Common scalar math helpers (Clamp, Lerp, Abs, Sin, PI).", "docUrl": "https://docs.unity3d.com/ScriptReference/Mathf.html" },
    { "symbol": "Debug", "kind": "class", "namespace": "UnityEngine", "summary": "Console logging (Log, LogWarning, LogError) and DrawLine/DrawRay gizmos.", "docUrl": "https://docs.unity3d.com/ScriptReference/Debug.html" },
    { "symbol": "Input", "kind": "class", "namespace": "UnityEngine", "summary": "Legacy Input Manager polling (GetKey, GetAxis, GetMouseButton). Prefer the Input System package for new work.", "replacement": "UnityEngine.InputSystem", "since": "Input System 1.0" },
    { "symbol": "Rigidbody", "kind": "class", "namespace": "UnityEngine", "summary": "Physics body driven by the PhysX solver.", "docUrl": "https://docs.unity3d.com/ScriptReference/Rigidbody.html" },
    { "symbol": "Collider", "kind": "class", "namespace": "UnityEngine", "summary": "Base class for physics colliders (Box, Sphere, Capsule, Mesh).", "docUrl": "https://docs.unity3d.com/ScriptReference/Collider.html" },
    { "symbol": "Physics", "kind": "class", "namespace": "UnityEngine", "summary": "Scene physics queries (Raycast, OverlapSphere, SphereCast).", "docUrl": "https://docs.unity3d.com/ScriptReference/Physics.html" },
    { "symbol": "Camera", "kind": "class", "namespace": "UnityEngine", "summary": "Renders the scene; Camera.main returns the tagged main camera.", "docUrl": "https://docs.unity3d.com/ScriptReference/Camera.html" },
    { "symbol": "Object.Instantiate", "kind": "method", "namespace": "UnityEngine", "summary": "Clones an Object, GameObject or Component.", "docUrl": "https://docs.unity3d.com/ScriptReference/Object.Instantiate.html" },
    { "symbol": "Object.Destroy", "kind": "method", "namespace": "UnityEngine", "summary": "Destroys an Object at the end of the frame; DestroyImmediate is editor-only.", "docUrl": "https://docs.unity3d.com/ScriptReference/Object.Destroy.html" },
    { "symbol": "Object.FindObjectOfType", "kind": "method", "namespace": "UnityEngine", "summary": "Obsolete scene lookup by type.", "replacement": "Object.FindFirstObjectByType", "since": "2023.1" },
    { "symbol": "Object.FindObjectsOfType", "kind": "method", "namespace": "UnityEngine", "summary": "Obsolete scene lookup returning all instances of a type.", "replacement": "Object.FindObjectsByType(FindObjectsSortMode.None)", "since": "2023.1" },
    { "symbol": "Object.FindAnyObjectOfType", "kind": "method", "namespace": "UnityEngine", "summary": "Obsolete non-deterministic scene lookup by type.", "replacement": "Object.FindAnyObjectByType", "since": "2023.1" },
    { "symbol": "GameObject.GetComponent", "kind": "method", "namespace": "UnityEngine", "summary": "Returns a component of type T on the GameObject, or null.", "docUrl": "https://docs.unity3d.com/ScriptReference/GameObject.GetComponent.html" },
    { "symbol": "GameObject.AddComponent", "kind": "method", "namespace": "UnityEngine", "summary": "Adds a component of type T at runtime and returns it.", "docUrl": "https://docs.unity3d.com/ScriptReference/GameObject.AddComponent.html" },
    { "symbol": "SceneManager", "kind": "class", "namespace": "UnityEngine.SceneManagement", "summary": "Loads and unloads scenes; LoadSceneAsync returns an AsyncOperation.", "docUrl": "https://docs.unity3d.com/ScriptReference/SceneManagement.SceneManager.html" },
    { "symbol": "Coroutine", "kind": "class", "namespace": "UnityEngine", "summary": "Handle returned by StartCoroutine; runs IEnumerator work across frames.", "docUrl": "https://docs.unity3d.com/ScriptReference/Coroutine.html" },
    { "symbol": "WaitForSeconds", "kind": "class", "namespace": "UnityEngine", "summary": "Yields for scaled seconds inside a coroutine.", "docUrl": "https://docs.unity3d.com/ScriptReference/WaitForSeconds.html" },
    { "symbol": "WaitForEndOfFrame", "kind": "class", "namespace": "UnityEngine", "summary": "Yields until rendering finishes for the frame.", "docUrl": "https://docs.unity3d.com/ScriptReference/WaitForEndOfFrame.html" },
    { "symbol": "SerializeField", "kind": "attribute", "namespace": "UnityEngine", "summary": "Serializes a private field in the Inspector.", "docUrl": "https://docs.unity3d.com/ScriptReference/SerializeField.html" },
    { "symbol": "RequireComponent", "kind": "attribute", "namespace": "UnityEngine", "summary": "Automatically adds required component types when a script is added.", "docUrl": "https://docs.unity3d.com/ScriptReference/RequireComponent.html" },
    { "symbol": "CreateAssetMenu", "kind": "attribute", "namespace": "UnityEngine", "summary": "Adds an Assets > Create menu entry for a ScriptableObject type.", "docUrl": "https://docs.unity3d.com/ScriptReference/CreateAssetMenuAttribute.html" },
    { "symbol": "HeaderAttribute", "kind": "attribute", "namespace": "UnityEngine", "summary": "Draws a bold header above a serialized field.", "docUrl": "https://docs.unity3d.com/ScriptReference/HeaderAttribute.html" },
    { "symbol": "RangeAttribute", "kind": "attribute", "namespace": "UnityEngine", "summary": "Renders a serialized float/int as a slider between min and max.", "docUrl": "https://docs.unity3d.com/ScriptReference/RangeAttribute.html" },
    { "symbol": "TooltipAttribute", "kind": "attribute", "namespace": "UnityEngine", "summary": "Shows a tooltip for a serialized field on hover.", "docUrl": "https://docs.unity3d.com/ScriptReference/TooltipAttribute.html" },
    { "symbol": "PlayerPrefs", "kind": "class", "namespace": "UnityEngine", "summary": "Small key/value store persisted per platform/user.", "docUrl": "https://docs.unity3d.com/ScriptReference/PlayerPrefs.html" },
    { "symbol": "Resources.Load", "kind": "method", "namespace": "UnityEngine", "summary": "Loads an asset from a Resources folder by path. Prefer Addressables for large projects.", "replacement": "UnityEngine.AddressableAssets.Addressables", "since": "Addressables 1.0" },
    { "symbol": "Application", "kind": "class", "namespace": "UnityEngine", "summary": "Runtime application info: platform, dataPath, persistentDataPath, isPlaying, Quit.", "docUrl": "https://docs.unity3d.com/ScriptReference/Application.html" },
    { "symbol": "Screen", "kind": "class", "namespace": "UnityEngine", "summary": "Screen resolution, DPI, orientation and fullscreen state.", "docUrl": "https://docs.unity3d.com/ScriptReference/Screen.html" },
    { "symbol": "Time.deltaTime", "kind": "property", "namespace": "UnityEngine", "summary": "Seconds elapsed since the previous frame (scaled).", "docUrl": "https://docs.unity3d.com/ScriptReference/Time-deltaTime.html" },
    { "symbol": "AsyncOperation", "kind": "class", "namespace": "UnityEngine", "summary": "Progress handle for async loads and scene activation.", "docUrl": "https://docs.unity3d.com/ScriptReference/AsyncOperation.html" },
    { "symbol": "UnityEngine.UI.Button", "kind": "class", "namespace": "UnityEngine.UI", "summary": "UGUI clickable button; onClick is a UnityEvent.", "docUrl": "https://docs.unity3d.com/Packages/com.unity.ugui@1.0/api/UnityEngine.UI.Button.html" },
    { "symbol": "UnityEngine.UIElements.UIDocument", "kind": "class", "namespace": "UnityEngine.UIElements", "summary": "Bridges a UXML/USS UI Toolkit document into a scene.", "docUrl": "https://docs.unity3d.com/ScriptReference/UIElements.UIDocument.html" },
    { "symbol": "TMPro.TextMeshProUGUI", "kind": "class", "namespace": "TMPro", "summary": "TextMeshPro UGUI text component; set .text and .color.", "docUrl": "https://docs.unity3d.com/Packages/com.unity.textmeshpro@3.0/api/TMPro.TextMeshProUGUI.html" }
  ]
}
