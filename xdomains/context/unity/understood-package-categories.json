      "reason": "IDE integration only (Rider/Visual Studio/VS Code). No runtime API or code-generation impact."
    },
    {
      "packageName": "com.unity.collab-proxy",
      "reason": "Unity Version Control integration. No runtime API or code-generation impact."
    },
    {
