{
  "version": "1.0",
  "description": "Maps Unity package ids (version-agnostic) to a general category and a pretty name. Used to translate a scanned project's unity_packages into project_capabilities so the System Builder and Unity sub-agents know which Unity features a project actually uses. Add rows freely; leave category blank when it is not yet known. Ids beginning with 'com.unity.builtin.' are synthetic: they are not in Packages/manifest.json and must be emitted by the scanner (for example from ProjectSettings) so built-in features that have no package can participate in package-choices decisions.",
  "fields": {
    "category": "General capability area this package belongs to (see categoryLegend). Blank = unknown, to be filled in later.",
    "packageName": "Unity package id exactly as it appears in Packages/manifest.json, with any version, tag, or URL stripped.",
    "prettyName": "Camel/Pascal-case rendering of the last segment after the final '.' of packageName (hyphenated segments are treated as one segment and camel-cased)."
  },
  "categoryLegend": {
    "rendering": "Render pipelines, shaders, and graphics features.",
    "ui": "Runtime UI systems and text rendering.",
    "2d": "2D authoring, sprites, and the 2D import pipeline.",
    "input": "Input handling and control schemes.",
    "animation": "Animation, cutscene, and sequencing systems.",
    "camera": "Camera behaviour and framing.",
    "scripting": "Visual scripting and node-based logic authoring.",
    "audio": "Audio playback and management.",
    "ai": "Navigation, machine-learning inference, and AI-assisted tooling.",
    "async": "Async/await and task composition.",
    "dependency-injection": "DI containers and inversion of control.",
    "content-management": "Asset loading, addressables, and bundles.",
    "asset-management": "Asset bundles and low-level asset packaging.",
    "xr": "XR/VR/AR platform support.",
    "serialization": "JSON/object serialization.",
    "testing": "Test framework and test running.",
    "mobile": "Mobile platform and performance features.",
    "level-design": "Level and geometry prototyping.",
    "build": "Build pipeline and automation.",
    "architecture": "Project-level architecture frameworks.",
    "monetization": "Ratings, ads, and monetization.",
    "editor-tooling": "Editor-only authoring tools.",
    "native": "Native plugin integration."
  },
  "packages": [
    { "category": "rendering", "packageName": "com.unity.render-pipelines.universal", "prettyName": "Universal" },
    { "category": "rendering", "packageName": "com.unity.render-pipelines.core", "prettyName": "Core" },
    { "category": "native", "packageName": "com.watanabe-koya.graphicscapture", "prettyName": "GraphicsCapture" },
    { "category": "ui", "packageName": "com.unity.ugui", "prettyName": "UGUI" },
